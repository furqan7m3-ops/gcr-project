# Database connection for Prisma and the application.
# Docker Compose starts PostgreSQL on localhost:5432.
DATABASE_URL="postgresql://gcr:gcr_password@localhost:5432/gcr_dev?schema=public"

# Authentication secret used by Auth.js in the future.
AUTH_SECRET="replace-me-with-a-long-random-string"

# Base URL for Auth.js and future server-side callbacks.
NEXTAUTH_URL="http://localhost:3000"

# Future storage configuration placeholders.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
